--- !u!114 &-2736502439033216727
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: 
  Text:
    m_Untranslated: "<b>1.</b> Click the link below to view the free <b>Food pack</b>
      assets on the Asset Store website.\n\n<a href=\"https://assetstore.unity.com/packages/3d/food-pack-3d-microgames-add-ons-163295\">Asset
      Store</a>\n\n<b>2.</b> On the webpage, add the assets by clicking the <b>\"Add
      to My Assets\u201D</b> button.\n\n<b>3.</b> After the <b>Food pack</b> assets
      have been added, click the <b>\"Open in Unity\"</b> button.\n\n<b>4.</b> Return
      to the Unity Editor, where the <b>Package Manager</b> window will appear. Select
      <b>Next</b> to continue."
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
