--- !u!114 &8097516357654044699
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 456c7c2b477e4253b9e4faf9ed4b18a9, type: 3}
  m_Name: InstructionsParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.InstructionsParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Title:
    m_Untranslated: 
  Text:
    m_Untranslated: '<b>1.</b> At the top of the <b>Package Manager</b> window, in
      the <b>Packages:</b> dropdown, select <b>My Assets</b>.


      <b>2.</b> Select
      the <b>Food pack</b> asset, then click the <b>Import</b> button to open the
      <b>Import Unity Package</b> window.


      <b>3.</b> In the <b>Import Unity
      Package</b> window, select the <b>Import</b> button.


      <b>4.</b> When
      the import has finished, return to this tutorial and select <b>Next</b> to
      continue.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
