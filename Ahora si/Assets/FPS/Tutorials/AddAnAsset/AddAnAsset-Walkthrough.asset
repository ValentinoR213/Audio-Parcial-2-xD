  Title:
    m_Untranslated: 
  Text:
    m_Untranslated: '<b>1.</b> Select the Assets folder and search "food" in the
      search bar.


      <b>2.</b> Open the folder titled <b>Mg3D_Food.</b>


      <b>3.</b>
      Select and drag the assets into the Scene view.


      <b>4.</b> When you''re
      done, select <b>Next</b> to continue.'
  m_CriteriaCompletion: 0
  m_Criteria:
    m_Items: []
