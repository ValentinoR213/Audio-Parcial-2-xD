    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "In this tutorial, you learned some basics of the Unity Editor
      interface, decreased the player's gravity, and playtested. \n\nNext, you\u2019ll
      start making your own changes!"
--- !u!114 &-7946822775419503815
MonoBehaviour:
  m_ObjectHideFlags: 1
