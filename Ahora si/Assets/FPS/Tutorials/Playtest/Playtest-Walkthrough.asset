--- !u!114 &8288789509194658740
MonoBehaviour:
  m_ObjectHideFlags: 1
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 0}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: 935228c0fd2628c4db5028980babef0b, type: 3}
  m_Name: NarrativeParagraph
  m_EditorClassIdentifier: Unity.Tutorials.Editor::Unity.Tutorials.Editor.Paragraphs.NarrativeParagraph
  m_MaskingSettings:
    m_MaskingEnabled: 0
    m_UnmaskedViews: []
    MaskPreset: {fileID: 0}
  Text:
    m_Untranslated: "The <b>Gravity Down Force</b> property controls how high the
      player can jump.\n\nGo deeper:\n\n\u2022 When you select a GameObject in the
      Hierarchy, you\u2019ll see its <b>components</b> in the <b>Inspector</b>. \n\n\u2022
      Components contain <b>properities</b> that give a GameObject specific functionalities.\n\n\u2022
      The <b>Player Character Controller</b> properties are what make the player
      character move in response to player input."
